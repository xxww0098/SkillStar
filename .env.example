# Antigravity (Google IDE) OAuth — optional override for Usage login / quota refresh.
# SkillStar ships the public desktop OAuth client used by Antigravity/Cockpit Tools.
# Only set these when Google rotates that client or you register your own.
# Optional file shape: ~/.skillstar/config/antigravity_oauth.json:
#   { "client_id": "...", "client_secret": "..." }
SKILLSTAR_ANTIGRAVITY_CLIENT_ID=
SKILLSTAR_ANTIGRAVITY_CLIENT_SECRET=

# Optional OAuth client overrides for Usage providers. Each ships a working
# built-in default, so leave these blank unless a built-in client gets rotated
# or you register your own. Resolution order per value:
#   env var → compile-time option_env! → ~/.skillstar/config/oauth_clients.json → built-in default
# The JSON file shape is:
#   { "codex": { "client_id": "..." }, "trae": { "client_id": "...", "client_secret": "..." }, ... }
SKILLSTAR_CODEX_CLIENT_ID=
SKILLSTAR_XAI_CLIENT_ID=
SKILLSTAR_TRAE_CLIENT_ID=
SKILLSTAR_TRAE_CLIENT_SECRET=
SKILLSTAR_OPENCODE_CLIENT_ID=

# Public (non-secret) client ID of the registered SkillStar GitHub App.
# Device Flow must be enabled for the app. Release builds embed this at compile
# time. Local `tauri dev` reads this key from the repo-root `.env` on login;
# you do not need to export it in the shell.
SKILLSTAR_GITHUB_APP_CLIENT_ID=
