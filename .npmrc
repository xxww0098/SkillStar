# Pin peer-dependency behaviour to npm's default so package-lock.json is
# always generated the way CI's `npm ci` validates it. A developer-global
# `~/.npmrc` with `legacy-peer-deps=true` silently produced lockfiles without
# auto-installed peers (@lobehub/ui, antd, ...), which failed every Windows CI
# run at `npm ci` with "Missing: ... from lock file" (windows-ci.yml failure
# lesson 1). Project config takes precedence over the user config.
legacy-peer-deps=false
